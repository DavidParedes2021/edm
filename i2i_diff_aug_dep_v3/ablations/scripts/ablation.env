# ablation.env — single source of truth for every ablation script.
#
# Each line is KEY=value (no `export`). The launcher scripts source this file
# with auto-export semantics so the values are also visible to the python
# subprocesses they spawn.
#
# Edit the paths under "REQUIRED" before running setup_ablations.sh. Leave the
# others at their defaults unless you have a reason to change them.

# ─── REQUIRED — point at your data and production scripts ──────────────────
NORMAL_TRAIN_DIR="../../../../data/datasets/kvasir_classified/none_filtered"
NORMAL_TEST_DIR="../../../../data/datasets/kvasir_classified/none_filtered"                  # ~3000 frames; subsampled below
REAL_OVER_DIR="../../../../data/datasets/kvasir_classified_subset/kvasir_classified_subset/underexposed"                      # FID/KID reference (unpaired)
REAL_UNDER_DIR="../../../../data/datasets/kvasir_classified_subset/kvasir_classified_subset/overexposed"                    # FID/KID reference (unpaired)

# Folder that contains the WORKING production scripts:
#   depth_estimator.py / generate_pairs.py / depth_augment.py / exposure_augment.py
# May be inside this repo (e.g. "code _to_generate_pairs") OR an absolute path
# elsewhere on disk. The root copies of these files in the repo root are older
# snapshots and are NOT used by the ablation pipeline. Quote the value if the
# path contains spaces — the launcher scripts do this for you.
PROD_CODE_DIR="../i2i_pair_compare/code _to_generate_pairs"

# ─── Depth estimator backend ────────────────────────────────────────────────
# 'hadepth'   = the production endoscopy-fine-tuned model (best quality)
# 'dav2_endo' = Depth Anything V2 with endoscopy pre/post (fallback)
# 'midas'     = plain MiDaS (only if HADepth not available)
DEPTH_BACKEND=hadepth
HADEPTH_REPO="../i2i_pair_compare/HADepth"
HADEPTH_CKPT="../i2i_pair_compare/HADepth/HADepth_fullmodel"

# ─── Pair-generation mask strategy ──────────────────────────────────────────
# BASELINE / LAB_FULL / loss variants use $MASK_STRATEGY_BASELINE (production
# default = hybrid). The A1 NO_DEPTH variant uses $MASK_STRATEGY_NO_DEPTH so
# the training targets contain ZERO depth contribution — only the L channel.
MASK_STRATEGY_BASELINE=hybrid
MASK_STRATEGY_NO_DEPTH=luminance
HYBRID_BLEND=0.5
GAMMA_OVER=2.0
GAMMA_UNDER=2.5

# ─── OPTIONAL — output layout & throttles ───────────────────────────────────
ABL_ROOT="../../../../projects/ablation_exp/outputs"
EPOCHS=150
NUM_VARIANTS=1

# Test-set sub-sampling. setup_ablations.sh builds a fixed N-image subset of
# NORMAL_TEST_DIR (deterministic, seed=TEST_SAMPLE_SEED) at $ABL_ROOT/data/
# test_normal_subset, and that subset is what every evaluator scores. Bump
# this if you want more reference frames per metric (recommended ≥ 200 for
# stable FID/KID).
TEST_MAX_IMAGES=200
TEST_SAMPLE_SEED=42

# Per-launcher overrides (optional, leave empty to disable)
ONLY_DOMAIN=                                       # under | over
ONLY_VARIANT=                                      # e.g. BASELINE
MAX_IMAGES=                                        # cap eval to N images for a smoke run

# Derived defaults (you usually don't need to touch these)
PAIRS_BASELINE=$ABL_ROOT/data/pairs_baseline
PAIRS_NO_DEPTH=$ABL_ROOT/data/pairs_no_depth
DEPTH_DIR=$ABL_ROOT/data/depth_train
TEST_NORMAL_SUBSET=$ABL_ROOT/data/test_normal_subset
DEPTH_TEST_DIR=$ABL_ROOT/data/depth_test
TEST_PAIRS=$ABL_ROOT/data/test_pairs
